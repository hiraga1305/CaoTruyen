{
  "active_provider": "gemini",
  "providers": {
    "gemini": {
      "description": "Google AI Studio API (Gemini Flash / Flash Lite)",
      "api_keys": [
        "YOUR_GEMINI_API_KEY"
      ],
      "models": [
        "gemini-flash-latest",
        "gemini-flash-lite-latest",
        "gemini-3.1-flash-lite",
        "gemini-3.8-flash"
      ],
      "thinking_budget": 0,
      "temperature": 0.7
    },
    "deepseek": {
      "description": "DeepSeek Official API (DeepSeek-V3 / DeepSeek-R1)",
      "api_key": "YOUR_DEEPSEEK_API_KEY",
      "base_url": "https://api.deepseek.com/v1",
      "models": [
        "deepseek-chat",
        "deepseek-reasoner"
      ],
      "temperature": 0.7
    },
    "openrouter": {
      "description": "OpenRouter (Đa nguồn: Qwen 2.5 72B, Claude 3.5, Gemini 2.0...)",
      "api_key": "YOUR_OPENROUTER_API_KEY",
      "base_url": "https://openrouter.ai/api/v1",
      "models": [
        "deepseek/deepseek-chat",
        "qwen/qwen-2.5-72b-instruct",
        "google/gemini-2.0-flash-001"
      ],
      "temperature": 0.7
    },
    "custom_openai": {
      "description": "Bất kỳ server nào hỗ trợ chuẩn OpenAI (Groq, Together, Ollama, v.v.)",
      "api_key": "YOUR_CUSTOM_API_KEY",
      "base_url": "https://api.openai.com/v1",
      "models": [
        "gpt-4o-mini"
      ],
      "temperature": 0.7
    }
  },
  "settings": {
    "chunk_size_paragraphs": 60,
    "max_retries": 3,
    "retry_delay_seconds": 2,
    "request_timeout_seconds": 60,
    "log_level": "INFO"
  }
}
