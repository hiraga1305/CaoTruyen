{
  "version": "bns-source-v1",
  "book_id": "49736",
  "chapter": 280,
  "title": "280.第280章 冷靜的瘋子",
  "source_ref": "https://czbooks.net/n/s6p7bb/s6ppgb59?chapterNumber=279",
  "segments": [
    {
      "id": "c0280p0001",
      "source": "280.第280章 冷靜的瘋子"
    },
    {
      "id": "c0280p0002",
      "source": "第280章 冷靜的瘋子"
    },
    {
      "id": "c0280p0003",
      "source": "雲千峰睡得並不安生，總覺得心裡膈應著什麽，惴惴不安。"
    },
    {
      "id": "c0280p0004",
      "source": "天亮後是一個豔陽天。"
    },
    {
      "id": "c0280p0005",
      "source": "沒有了雨水匯聚的河流，也沒有之前留在河底的淺沙，世界變成了只有綠色。"
    },
    {
      "id": "c0280p0006",
      "source": "雲千峰走出破觀大門，看著晴朗悶熱的天氣，陷入沉思之中。"
    },
    {
      "id": "c0280p0007",
      "source": "“不引路了嗎？呵”"
    },
    {
      "id": "c0280p0008",
      "source": "突然他似乎想通了什麽，嘴角翹起一絲冷笑，轉身形回到了破道觀之中，竟然不走了。"
    },
    {
      "id": "c0280p0009",
      "source": "熱好了駱駝肉，吃飽了早餐，倒在地上睡回籠覺。"
    },
    {
      "id": "c0280p0010",
      "source": "此刻，某處。"
    },
    {
      "id": "c0280p0011",
      "source": "一個雍容華貴的女人正在窗前看著窗外的枝繁葉茂。"
    },
    {
      "id": "c0280p0012",
      "source": "那異常柔軟，叫小蟾的女人走進屋來低聲道："
    },
    {
      "id": "c0280p0013",
      "source": "“主人，他不走了。”"
    },
    {
      "id": "c0280p0014",
      "source": "窗前雍容之人很明顯背影一頓，竟是愣了一下。"
    },
    {
      "id": "c0280p0015",
      "source": "隨後淡淡道："
    },
    {
      "id": "c0280p0016",
      "source": "“果然，能走到這一步的，都不會是凡夫俗子，既然他看懂了，那就不用等到明天了，現在就去帶著他拿到東西，速速離開吧。”"
    },
    {
      "id": "c0280p0017",
      "source": "小蟾低聲道："
    },
    {
      "id": "c0280p0018",
      "source": "“主人，若是他看懂的更遠，拒絕一些事情，甚至小蟾怕不是他的對手。”"
    },
    {
      "id": "c0280p0019",
      "source": "更遠的是什麽？自然是那句“留不得”。"
    },
    {
      "id": "c0280p0020",
      "source": "那雍容之人也不回頭，而是緩緩搖頭道："
    },
    {
      "id": "c0280p0021",
      "source": "“他既然懂了，就知道你是我的人，不敢對你怎樣，你放心去吧，他會跟從你完成所有的步驟，因為他有必須去救的人，帝嚳早已算死他。”"
    },
    {
      "id": "c0280p0022",
      "source": "小蟾這才轉身出去。"
    },
    {
      "id": "c0280p0023",
      "source": "雲千峰並沒有真的睡著，遠遠的聽到了腳步聲靠近，就懶洋洋的坐起來，背靠著神龕，抽出一根煙來點燃，看著門口的佳人。"
    },
    {
      "id": "c0280p0024",
      "source": "挺拔不及第一夜那人，玲瓏不及昨夜之人，但是這柔軟起伏卻遠勝之前二人。"
    },
    {
      "id": "c0280p0025",
      "source": "眼看門口佳人要開口說話，雲千峰當先一句把她的話堵回去："
    },
    {
      "id": "c0280p0026",
      "source": "“當年你們也是這樣招待周穆王的？一天一女，所謂三天？”"
    },
    {
      "id": "c0280p0027",
      "source": "小蟾點了點頭，恭敬道："
    },
    {
      "id": "c0280p0028",
      "source": "“是的。”"
    },
    {
      "id": "c0280p0029",
      "source": "雲千峰吐了個煙圈，笑道："
    },
    {
      "id": "c0280p0030",
      "source": "“那看來，你們是把我當成王的級別來待遇的。”"
    },
    {
      "id": "c0280p0031",
      "source": "小蟾表情不卑不亢，但聲音裡帶著與生俱來的倨傲，道："
    },
    {
      "id": "c0280p0032",
      "source": "“蚩尤本也算王，當得這樣的款待。”"
    },
    {
      "id": "c0280p0033",
      "source": "“卓瑪也是你們的姐妹嗎？”"
    },
    {
      "id": "c0280p0034",
      "source": "“是的，但她是信使，非特殊原因不得歸瑤池。”"
    },
    {
      "id": "c0280p0035",
      "source": "“我這次看來是見不到你家主人了？”"
    },
    {
      "id": "c0280p0036",
      "source": "“是的，主人金口玉言說了，不會見你。”"
    },
    {
      "id": "c0280p0037",
      "source": "雲千峰緩緩點了點頭，見小蟾又要開口說話，急忙一嘴又給堵了回去，道："
    },
    {
      "id": "c0280p0038",
      "source": "“為什麽不是人身蛇尾？”"
    },
    {
      "id": "c0280p0039",
      "source": "小蟾又把剛要說的話咽了回去，但臉上已是極不耐煩，畢竟誰被打斷幾次要說的話，都會很不爽，尤其看得出對方是故意的，於是小蟾冷冷道："
    },
    {
      "id": "c0280p0040",
      "source": "“體內有兩套基因。”"
    },
    {
      "id": "c0280p0041",
      "source": "雲千峰直接以命令的口氣，道："
    },
    {
      "id": "c0280p0042",
      "source": "“變人身蛇尾！”"
    },
    {
      "id": "c0280p0043",
      "source": "小蟾微微仰臉，冷笑道："
    },
    {
      "id": "c0280p0044",
      "source": "“小蟾不想。”"
    },
    {
      "id": "c0280p0045",
      "source": "雲千峰冷冷的看著小蟾，幾乎是在牙縫裡擠出聲音，道："
    },
    {
      "id": "c0280p0046",
      "source": "“我再說一遍，變人身蛇尾！”"
    },
    {
      "id": "c0280p0047",
      "source": "此時的雲千峰，如此長時間來被算計的怒火，已經有些壓抑不住。"
    },
    {
      "id": "c0280p0048",
      "source": "你算計我可以，要算死我也行，但你不能一邊算計我，還叫人三番兩次來教育自己，還必須讓我敬仰你並且甘心情願去被算計，那辦不到。"
    },
    {
      "id": "c0280p0049",
      "source": "而且對方連主人家見一面都省了，這依舊意味著，對方算計自己，但在對方眼裡，自己連個開席的涼菜都算不上，根本不在對方眼裡，這種倨傲，更成了雲千峰憤怒的導火索。"
    },
    {
      "id": "c0280p0050",
      "source": "對方既然面子裡子全都要給自己刮乾淨，那雲千峰就先把對方的臉面扯下來！"
    },
    {
      "id": "c0280p0051",
      "source": "小蟾不出聲，就那麽微微仰著臉看著雲千峰，目光沒有絲毫退縮。"
    },
    {
      "id": "c0280p0052",
      "source": "“唰！”"
    },
    {
      "id": "c0280p0053",
      "source": "身著黑甲的雲千峰上一秒還懶洋洋的背靠著神龕，下一秒已經化成一道黑影，速度極快的貼著地皮來到了門口處。"
    },
    {
      "id": "c0280p0054",
      "source": "這動作驚得小蟾一跳，還沒等反應過來，就聽“啪”的一聲脆響。"
    },
    {
      "id": "c0280p0055",
      "source": "小蟾臉上結實的挨了一巴掌，摔倒進門口。"
    },
    {
      "id": "c0280p0056",
      "source": "雲千峰站在小蟾旁，居高臨下，冷笑道："
    },
    {
      "id": "c0280p0057",
      "source": "“我不介意弄死你，讓她換個人來和我辦事。”"
    },
    {
      "id": "c0280p0058",
      "source": "小蟾聲音眼中顯出驚慌，急道："
    },
    {
      "id": "c0280p0059",
      "source": "“你敢！我可是娘娘的人。”"
    },
    {
      "id": "c0280p0060",
      "source": "雲千峰冷笑道："
    },
    {
      "id": "c0280p0061",
      "source": "“你以為我為什麽打你？”"
    },
    {
      "id": "c0280p0062",
      "source": "小蟾瞬間懂了。"
    },
    {
      "id": "c0280p0063",
      "source": "眼前這貨看得的確夠遠，什麽都看懂了，所以現在是發瘋呢，如果自己不照辦，估計對方真的敢弄死自己當墊背。"
    },
    {
      "id": "c0280p0064",
      "source": "打狗看主人，這就是打給主人看的。"
    },
    {
      "id": "c0280p0065",
      "source": "對於蚩尤幾乎滿身的人，小蟾那點能耐，還真不是雲千峰對手。"
    },
    {
      "id": "c0280p0066",
      "source": "而且就那速度，估計跑也是跑不掉的。"
    },
    {
      "id": "c0280p0067",
      "source": "關鍵是也不敢跑，娘娘給的任務還沒完成呢，眼前這人很明顯知道，娘娘現在不敢把他怎麽樣，所以有恃無恐。"
    },
    {
      "id": "c0280p0068",
      "source": "當下雖然氣的呼吸急促，但還是轉成了恭敬的語氣道："
    },
    {
      "id": "c0280p0069",
      "source": "“小蟾變就是。”"
    },
    {
      "id": "c0280p0070",
      "source": "說著，裙子內的雙腿開始泛出淡青色的鱗片紋理，露在裙外的雙腳踝開始漸漸相容。"
    },
    {
      "id": "c0280p0071",
      "source": "小蟾臉上也現出了痛苦的表情。"
    },
    {
      "id": "c0280p0072",
      "source": "很顯然，這種基因的轉換是極為痛苦的。"
    },
    {
      "id": "c0280p0073",
      "source": "雲千峰就靠在門旁，點了根煙，慢慢吸著，看著，饒有興致。"
    },
    {
      "id": "c0280p0074",
      "source": "不多時，小蟾完成了兩套基因外顯的變化。"
    },
    {
      "id": "c0280p0075",
      "source": "雲千峰夾煙的手輕輕一抬，道："
    },
    {
      "id": "c0280p0076",
      "source": "“站起來！”"
    },
    {
      "id": "c0280p0077",
      "source": "又是命令的口吻。"
    },
    {
      "id": "c0280p0078",
      "source": "小蟾忍氣，纖腰一動，便直直的立了起來。"
    },
    {
      "id": "c0280p0079",
      "source": "雲千峰好似觀賞物件似的，繞著小蟾轉了三圈，突然罵道："
    },
    {
      "id": "c0280p0080",
      "source": "“這特麽看得見什麽？褪了！”"
    },
    {
      "id": "c0280p0081",
      "source": "小蟾氣得渾身發抖，雲千峰卻朝她臉上吐了一串煙圈。"
    },
    {
      "id": "c0280p0082",
      "source": "“呼”"
    },
    {
      "id": "c0280p0083",
      "source": "外面傳來一陣悶響，似乎有什麽在由遠及近快速趕來，雲千峰猛回頭，對著聲音來處高喊道："
    },
    {
      "id": "c0280p0084",
      "source": "“好一個金口玉言，你說不見，還敢現身嗎？”"
    },
    {
      "id": "c0280p0085",
      "source": "那悶響聲戛然而止。"
    },
    {
      "id": "c0280p0086",
      "source": "“哈哈哈！”"
    },
    {
      "id": "c0280p0087",
      "source": "雲千峰對著門外的叢林一陣狂笑，他把難題給了這裡的主人，你出來就是食言不要臉，不出來我就打你的臉，自己選！裡子我現在刮不動，但這面子我禍害定了。"
    },
    {
      "id": "c0280p0088",
      "source": "笑過後，雲千峰回頭看著小蟾，陰森森道："
    },
    {
      "id": "c0280p0089",
      "source": "“還等什麽？”"
    },
    {
      "id": "c0280p0090",
      "source": "小蟾似乎認命了，心知不會有幫手，於是把手伸向連襟的衣衫。"
    },
    {
      "id": "c0280p0091",
      "source": "乾淨了以後，雲千峰又是繞了三圈，看得仔細，相當仔細。"
    },
    {
      "id": "c0280p0092",
      "source": "然後道："
    },
    {
      "id": "c0280p0093",
      "source": "“去那站著，手扶著牆。”"
    },
    {
      "id": "c0280p0094",
      "source": "小蟾知道，自己上了雲千峰的當了。"
    },
    {
      "id": "c0280p0095",
      "source": "這個混蛋問的那句“我不會見到你家娘娘”的話，就是為了現在這個場景做的陷阱，這份算計讓小蟾心裡發寒。"
    },
    {
      "id": "c0280p0096",
      "source": "他堵住了娘娘出現的可能，可以肆意妄為的靠著自己來報復自己的主人，因為他很清楚的知道，算計自己命運的執行者，就包括自己的主人。"
    },
    {
      "id": "c0280p0097",
      "source": "小蟾顫抖著，用手扶著牆，忍著眼淚道："
    },
    {
      "id": "c0280p0098",
      "source": "“你不配稱王，你是魔鬼！”"
    },
    {
      "id": "c0280p0099",
      "source": "“蚩尤不一直都是你們口中的魔鬼嗎？我這叫如你等所願！”"
    },
    {
      "id": "c0280p0100",
      "source": "“啊！.你會受到懲罰的.呃！”"
    },
    {
      "id": "c0280p0101",
      "source": "“嗡”"
    },
    {
      "id": "c0280p0102",
      "source": "遙遠處，似有似無的飄來一聲怒吼。"
    },
    {
      "id": "c0280p0103",
      "source": "只是很遠，聽不清。"
    },
    {
      "id": "c0280p0104",
      "source": "雲千峰獰笑著。"
    },
    {
      "id": "c0280p0105",
      "source": "小蟾在這一刻才明白，為什麽自家主人說這人不能留。"
    },
    {
      "id": "c0280p0106",
      "source": "“他是個頭腦冷靜的瘋子！這世上最可怕的一種人！”"
    },
    {
      "id": "c0280p0107",
      "source": "小蟾在前，雲千峰在後，倆人走在無邊的綠色之中。"
    },
    {
      "id": "c0280p0108",
      "source": "小蟾一聲不吭，臉色鐵青，她又被逼著變回了雙腿。"
    },
    {
      "id": "c0280p0109",
      "source": "雲千峰哼著“你身上有他的香水味”，愜意自然。"
    },
    {
      "id": "c0280p0110",
      "source": "很快倆人來到一個露天的黑色祭壇。"
    },
    {
      "id": "c0280p0111",
      "source": "雲千峰膻中內的全知之眼也早早感覺到了蚩尤的召喚。"
    },
    {
      "id": "c0280p0112",
      "source": "蚩尤左腿，就在黑色祭壇之上，孤單安靜的落在哪裡。"
    },
    {
      "id": "c0280p0113",
      "source": "祭壇是精美的，配得上。"
    },
    {
      "id": "c0280p0114",
      "source": "雲千峰走上祭壇，捧起最後這一部分蚩尤，感受到全身蚩尤甲的顫栗。"
    },
    {
      "id": "c0280p0115",
      "source": "那是對完整的期盼。"
    },
    {
      "id": "c0280p0116",
      "source": "小蟾冷聲道："
    },
    {
      "id": "c0280p0117",
      "source": "“還愣著幹什麽？穿上吧！”"
    },
    {
      "id": "c0280p0118",
      "source": "雲千峰淡淡道："
    },
    {
      "id": "c0280p0119",
      "source": "“急什麽？這裡又不是終點站，等到了地方再穿不遲，我還有話要交代。”"
    },
    {
      "id": "c0280p0120",
      "source": "小蟾冷冷道："
    },
    {
      "id": "c0280p0121",
      "source": "“有什麽要交代的，說吧。”"
    },
    {
      "id": "c0280p0122",
      "source": "雲千峰不屑道："
    },
    {
      "id": "c0280p0123",
      "source": "“叫聲那麽賤的人也配聽？速速領路，別廢話。”"
    },
    {
      "id": "c0280p0124",
      "source": "小蟾捏緊的拳頭“哢哢哢”響個不停，顯然已經氣急。"
    },
    {
      "id": "c0280p0125",
      "source": "但她不敢發作，因為她很清楚，雲千峰現在是按照既定的順序走，她只能相助，不能做其他事，否則就是阻撓，主人的懲罰更可怕。"
    },
    {
      "id": "c0280p0126",
      "source": "於是便在祭壇旁邊，轉動幾個獸頭的雕刻，不多時機括聲轟隆隆傳出，祭台中心拱出一座黑色的石碑。"
    },
    {
      "id": "c0280p0127",
      "source": "小蟾冷冷道："
    },
    {
      "id": "c0280p0128",
      "source": "“二十一眼天珠是鑰匙，進去後就是你的終點站。”"
    },
    {
      "id": "c0280p0129",
      "source": "雲千峰也沒說話，看著小蟾，然後嗅了嗅自己除了拇指外的四根手指，這才笑著走上祭台，來到黑石之前，屏息調整大腦接收頻段。"
    },
    {
      "id": "c0280p0130",
      "source": "小蟾被雲千峰嗅手指的動作氣到眼前發黑，全身顫栗，臉上現出痛苦的神色，似乎已經快要達到忍耐的極限。"
    },
    {
      "id": "c0280p0131",
      "source": "好在這時雲千峰走進黑色石碑，消失在祭台之上。"
    },
    {
      "id": "c0280p0132",
      "source": "那一刻，小蟾終於忍不住，癱倒在地上，發出了撕心裂肺的怒吼。"
    },
    {
      "id": "c0280p0133",
      "source": "“啊”"
    }
  ],
