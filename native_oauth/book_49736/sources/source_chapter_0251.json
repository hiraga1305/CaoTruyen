{
  "version": "bns-source-v1",
  "book_id": "49736",
  "chapter": 251,
  "title": "251.第251章 答案",
  "source_ref": "https://czbooks.net/n/s6p7bb/s6pfielb?chapterNumber=250",
  "segments": [
    {
      "id": "c0251p0001",
      "source": "251.第251章 答案"
    },
    {
      "id": "c0251p0002",
      "source": "第251章 答案"
    },
    {
      "id": "c0251p0003",
      "source": "李銳倒在了地上。"
    },
    {
      "id": "c0251p0004",
      "source": "他的朱砂掌讓雲千峰很痛，的確是很神奇的透勁。"
    },
    {
      "id": "c0251p0005",
      "source": "但雲千峰扭斷了他的脖子。"
    },
    {
      "id": "c0251p0006",
      "source": "第三個人端著酒杯走上來，看著面帶笑容而死的李銳，歎了口氣道："
    },
    {
      "id": "c0251p0007",
      "source": "“老大，你這次的選擇是對的，人力無論如何開發，都太有限了，只靠人類自己，勝不了！你這次的選擇是對的！敬你！”"
    },
    {
      "id": "c0251p0008",
      "source": "又是一句雲千峰聽不懂的話。"
    },
    {
      "id": "c0251p0009",
      "source": "但雲千峰知道，自己想要知道答案，就要讓他們一個一個的躺在擂台上，直到最後一人。"
    },
    {
      "id": "c0251p0010",
      "source": "隨著酒杯啐碎的聲響，又是一場快速的生死決鬥。"
    },
    {
      "id": "c0251p0011",
      "source": "這第三人把一雙手掌練得比硬抓還硬，抓在祭台的石面上，都能劃出幾道痕跡，濺飛石粉。"
    },
    {
      "id": "c0251p0012",
      "source": "他也是出手最狠辣的一個，招招奔著雲千峰下三路，但是奈何身材瘦小，在雲千峰的身高和臂展下，根本無法近身。"
    },
    {
      "id": "c0251p0013",
      "source": "而且雲千峰的力氣太大了，也太過抗揍，只要躲開雙腿，他可以肆無忌憚的進攻。"
    },
    {
      "id": "c0251p0014",
      "source": "“哢！”"
    },
    {
      "id": "c0251p0015",
      "source": "一聲脆響，全屍。"
    },
    {
      "id": "c0251p0016",
      "source": "這是雲千峰能想到的，最不痛苦的方法。"
    },
    {
      "id": "c0251p0017",
      "source": "“老大，我是亨利，擅長心意把的橫式，變化雖少，但可借力打力，最是巧妙。”"
    },
    {
      "id": "c0251p0018",
      "source": "太極拳，正是源自這一橫式。"
    },
    {
      "id": "c0251p0019",
      "source": "“老大，我這人只是力大，掰手腕伱沒贏過我，這次看看我們誰更厲害”"
    },
    {
      "id": "c0251p0020",
      "source": "“老大，我擅長用刀，你也可以選擇武器”"
    },
    {
      "id": "c0251p0021",
      "source": "“老大，你的弱點是腿，我的強項是腿，控制距離對我沒有意義，抓住我的腿，是你唯一的機會.”"
    },
    {
      "id": "c0251p0022",
      "source": "“老大，我的聲帶特殊，身上的共鳴腔異於常人，能夠發出極高分貝和頻率的聲音，靠近了我能讓你瞬間耳聾，除非你能堵住耳朵”"
    },
    {
      "id": "c0251p0023",
      "source": "“老大，我修柔術，體軟如棉，你的關節技對我沒有用.”"
    },
    {
      "id": "c0251p0024",
      "source": "“老大，我的手掌是劇毒浸泡出來的，只要被我擦傷一點，就不可救藥.”"
    },
    {
      "id": "c0251p0025",
      "source": "“老大，我少林七十二技的八步掌小成，可於三米外傷人”"
    },
    {
      "id": "c0251p0026",
      "source": "“老大，我的拿手好戲是飛花摘葉，天下萬物到了我手裡，都是暗器，比如這酒杯和裡面的酒水.”"
    },
    {
      "id": "c0251p0027",
      "source": "“老大”"
    },
    {
      "id": "c0251p0028",
      "source": "一杯酒，一個人。"
    },
    {
      "id": "c0251p0029",
      "source": "每一個人對雲千峰都是坦坦蕩蕩，每一個人倒下的時候都帶著笑意。"
    },
    {
      "id": "c0251p0030",
      "source": "雲千峰全身已經被汗水濕透，但是他的眸子越來越冷，出手之時越來越果斷，絲毫沒有顧忌。"
    },
    {
      "id": "c0251p0031",
      "source": "只有這樣，才能抵禦那如針扎心的笑容。"
    },
    {
      "id": "c0251p0032",
      "source": "後面的人，招式也是愈加狠辣。"
    },
    {
      "id": "c0251p0033",
      "source": "正如第三個人說的，他們都是把身體開發到極強的人類，但也僅僅如此。"
    },
    {
      "id": "c0251p0034",
      "source": "人類的弱小，本就是造物主有意為之。"
    },
    {
      "id": "c0251p0035",
      "source": "每念及此，雲千峰就在心裡莫名的想到帝嚳。"
    },
    {
      "id": "c0251p0036",
      "source": "想知道他是如何憑借如此弱小的人類之軀，成為天上地下的千古一帝。"
    },
    {
      "id": "c0251p0037",
      "source": "琳達是這裡最幸福的人。"
    },
    {
      "id": "c0251p0038",
      "source": "她喝醉了，趴在地上睡得很沉，嘴裡還嘟囔著“一定要拿下”。"
    },
    {
      "id": "c0251p0039",
      "source": "很快，這偌大的石室內，只剩下三個還能呼吸的人。"
    },
    {
      "id": "c0251p0040",
      "source": "全身如水洗的雲千峰，遮著蓋頭的小神經，酩酊大罪的琳達。"
    },
    {
      "id": "c0251p0041",
      "source": "雲千峰轉身，看著立在西王母雕像旁的小神經，沉聲問道："
    },
    {
      "id": "c0251p0042",
      "source": "“現在可以告訴我答案了嗎？是誰派你們來的，是不是帝嚳的算計？”"
    },
    {
      "id": "c0251p0043",
      "source": "在雲千峰心裡，能布置這樣殘忍的局勢的人，只有帝嚳。"
    },
    {
      "id": "c0251p0044",
      "source": "讓最好的夥伴來殺死同伴，彼此成為祭品，世界上恐怕沒有比這更殘忍的事情。"
    },
    {
      "id": "c0251p0045",
      "source": "雲千峰發誓，如果這是帝嚳的算計，那麽他會不惜一切代價，破壞掉帝嚳在未來的所有算計。"
    },
    {
      "id": "c0251p0046",
      "source": "小神經聽著雲千峰那壓抑顫抖的聲音，用很平靜的語調回答道："
    },
    {
      "id": "c0251p0047",
      "source": "“答案就在我身上放著，打敗我，你就能拿到它。”"
    },
    {
      "id": "c0251p0048",
      "source": "這是雲千峰最恐懼聽到的話。"
    },
    {
      "id": "c0251p0049",
      "source": "祭台上的這些倒下的人，雲千峰心裡難受，但不會讓他崩潰，因為他對他們沒有記憶。"
    },
    {
      "id": "c0251p0050",
      "source": "但是小神經不一樣，不一樣！"
    },
    {
      "id": "c0251p0051",
      "source": "雲千峰緩緩走近小神經。"
    },
    {
      "id": "c0251p0052",
      "source": "小神經沒有要求雲千峰掀開蓋頭，她自己也沒有去掀開那紅色繡花的精致方布，似乎就準備以這樣無法看見的狀態與雲千峰一決生死。"
    },
    {
      "id": "c0251p0053",
      "source": "聽到雲千峰腳步聲的位置，已經在自己身前一米半，小神經緩緩伸出手，掌心朝上立在身前，這是詠春拳的引手。"
    },
    {
      "id": "c0251p0054",
      "source": "她準備用詠春聽勁的方式，與雲千峰盲打。"
    },
    {
      "id": "c0251p0055",
      "source": "然而下一秒，小神經感覺到自己腰上被一個硬硬的東西頂著，那是一把手槍。"
    },
    {
      "id": "c0251p0056",
      "source": "“你輸了。”"
    },
    {
      "id": "c0251p0057",
      "source": "雲千峰淡淡的說道。"
    },
    {
      "id": "c0251p0058",
      "source": "小神經的話裡沒提決生死，那麽雲千峰就不會放棄這自己最能接受的方式。"
    },
    {
      "id": "c0251p0059",
      "source": "小神經愣住了，她沒想到雲千峰竟然不講武德。"
    },
    {
      "id": "c0251p0060",
      "source": "然而事實上，這本就不是比武，而且從結果來看，自己的確是輸了。"
    },
    {
      "id": "c0251p0061",
      "source": "小神經垂下了攤出的右手，柔聲道："
    },
    {
      "id": "c0251p0062",
      "source": "“你贏了，掀開蓋頭。”"
    },
    {
      "id": "c0251p0063",
      "source": "雲千峰收起槍，用雙手托起那鮮紅的方布，露出了小神經清麗的面龐。"
    },
    {
      "id": "c0251p0064",
      "source": "她的臉很小，很俏。"
    },
    {
      "id": "c0251p0065",
      "source": "尤其今天，她破天荒的畫了淡妝，讓她的眼睛愈加深邃明亮，小小的嘴唇仿似熟透的櫻桃。"
    },
    {
      "id": "c0251p0066",
      "source": "“給我答案！”"
    },
    {
      "id": "c0251p0067",
      "source": "雲千峰看著一身紅妝的小神經，再次問道。"
    },
    {
      "id": "c0251p0068",
      "source": "小神經用雙臂攬住了雲千峰的腰，把臉靠在他的胸膛，聽著那“咚咚咚”的心跳，呢喃道："
    },
    {
      "id": "c0251p0069",
      "source": "“在我衣服裡，貼著我的皮膚，自己去拿。”"
    },
    {
      "id": "c0251p0070",
      "source": "雲千峰接收到了小神經釋放的信號。"
    },
    {
      "id": "c0251p0071",
      "source": "他似乎明白小神經為什麽釋放這樣的信號，那就是因為那祭台上的一張張笑臉。"
    },
    {
      "id": "c0251p0072",
      "source": "她希望他們的靈魂能夠知道，兩個人真的在一起了。"
    },
    {
      "id": "c0251p0073",
      "source": "這與其說是寬慰靈魂，不如說是寬慰自己的內心。"
    },
    {
      "id": "c0251p0074",
      "source": "這本就是唯心的。"
    },
    {
      "id": "c0251p0075",
      "source": "雲千峰橫著抱起小神經，大步的走到西王母那巨大的雕像之後。"
    },
    {
      "id": "c0251p0076",
      "source": "雕像的陰影中，只有飄渺的火把光影偶爾騷擾到這裡。"
    },
    {
      "id": "c0251p0077",
      "source": "那很久之前，雲千峰就不止一次想象過的美好，他心裡最美的背影，完全坦誠的出現在自己眼中。"
    },
    {
      "id": "c0251p0078",
      "source": "小神經趴在那裡，以肘觸地，回望雲千峰，細眼如絲。"
    },
    {
      "id": "c0251p0079",
      "source": "雲千峰此刻才知道，什麽叫M骨天成。"
    },
    {
      "id": "c0251p0080",
      "source": "那應該是這個世界上最美妙的聲音在這個石廳內如煙如霧彌漫開。"
    },
    {
      "id": "c0251p0081",
      "source": "小神經沒有壓抑自己的聲音，她盡情的高歌著。"
    },
    {
      "id": "c0251p0082",
      "source": "如果人真的有靈魂，那麽他們一定聽得到。"
    },
    {
      "id": "c0251p0083",
      "source": "這是他們期盼多年的婚禮。"
    },
    {
      "id": "c0251p0084",
      "source": "良久"
    },
    {
      "id": "c0251p0085",
      "source": "小神經安靜的伏在雲千峰的懷裡。"
    },
    {
      "id": "c0251p0086",
      "source": "而雲千峰手中，是一個微型的數碼相機，原本應該是做偷拍之用的東西。"
    },
    {
      "id": "c0251p0087",
      "source": "這個相機就壓在小神經那堆衣服裡。"
    },
    {
      "id": "c0251p0088",
      "source": "小神經爬起來，雙手攀著雲千峰的肩膀，柔聲道："
    },
    {
      "id": "c0251p0089",
      "source": "“你要的答案都在裡面，但打開前，你一定要記得保持冷靜，這裡沒有人的對錯，只有選擇”"
    },
    {
      "id": "c0251p0090",
      "source": "感謝肖娜丶、尾數27538、對此不能靠近、liude的月票獎勵。"
    },
    {
      "id": "c0251p0091",
      "source": "謝謝你們的支持！！！"
    },
    {
      "id": "c0251p0092",
      "source": "感激！！！"
    },
    {
      "id": "c0251p0093",
      "source": "祝大家周末愉快，晚安！！！"
    }
  ],
