{
  "version": "bns-source-v1",
  "book_id": "49736",
  "chapter": 290,
  "title": "290.第290章 風水局",
  "source_ref": "https://czbooks.net/n/s6p7bb/s6pp3efc?chapterNumber=289",
  "segments": [
    {
      "id": "c0290p0001",
      "source": "290.第290章 風水局"
    },
    {
      "id": "c0290p0002",
      "source": "第290章 風水局"
    },
    {
      "id": "c0290p0003",
      "source": "十八層內。"
    },
    {
      "id": "c0290p0004",
      "source": "地獄的夜晚沒有星。"
    },
    {
      "id": "c0290p0005",
      "source": "到了夜裡，只剩下四周無盡的漆黑。"
    },
    {
      "id": "c0290p0006",
      "source": "那小小的篝火無法驅散這樣的黑暗，只能照亮小小的一塊地方。"
    },
    {
      "id": "c0290p0007",
      "source": "野牛肉大補，倆人現在身上熱氣亂竄。"
    },
    {
      "id": "c0290p0008",
      "source": "女人喜潔淨，尤其是這沒事就泡華清池的楊玉奴。"
    },
    {
      "id": "c0290p0009",
      "source": "吃飽後出了細汗，想到自己風吹日曬一千多年沒洗澡，楊玉奴就分外覺得難受。"
    },
    {
      "id": "c0290p0010",
      "source": "“郎君，妾身想去潔身，如此黏膩，非常不適，不瞞郎君，妾身略有潔癖。”"
    },
    {
      "id": "c0290p0011",
      "source": "雲千峰聽到這話就驚呆了，問道："
    },
    {
      "id": "c0290p0012",
      "source": "“你竟然有潔癖？你竟然說自己有潔癖？”"
    },
    {
      "id": "c0290p0013",
      "source": "楊玉奴被雲千峰反問的有點懵，因為她說的是真話，自己真的有潔癖，於是弱弱道："
    },
    {
      "id": "c0290p0014",
      "source": "“是有些的，郎君為何如此驚訝？難不成，太真在郎君眼裡很髒嗎？”"
    },
    {
      "id": "c0290p0015",
      "source": "說著，臉上露出了淡淡的哀怨、弱弱的委屈、小小的嗔怒，眸子裡還蒙了水霧。"
    },
    {
      "id": "c0290p0016",
      "source": "這就是楊玉奴的手段，表情用淡，絕不誇張。"
    },
    {
      "id": "c0290p0017",
      "source": "她倒不是想對雲千峰用馭男手段，完全是習慣。"
    },
    {
      "id": "c0290p0018",
      "source": "雲千峰摸了摸鼻子，舔了舔嘴唇，然後笑道："
    },
    {
      "id": "c0290p0019",
      "source": "“大丫鬟啊，你一千多年沒刷牙，都吃了牛肉了，你說你有潔癖”"
    },
    {
      "id": "c0290p0020",
      "source": "“嘔！！！”"
    },
    {
      "id": "c0290p0021",
      "source": "雲千峰話沒說完，楊玉奴吐了。"
    },
    {
      "id": "c0290p0022",
      "source": "心裡怒罵：“你缺德不缺德！”"
    },
    {
      "id": "c0290p0023",
      "source": "雲千峰不說這話，楊玉奴真沒想起來，餓壞了，而且一千多年，腦子還沒緩過來，這不是才吃飽，就才想起乾淨來，結果就被雲千峰沉重的打擊了一下。"
    },
    {
      "id": "c0290p0024",
      "source": "“嚶嚶嬰太真不活了吧嗚嗚嗚.在郎君眼裡太真成了.”"
    },
    {
      "id": "c0290p0025",
      "source": "一哭二鬧三上吊的前奏。"
    },
    {
      "id": "c0290p0026",
      "source": "雲千峰都要笑岔氣了，當下忙拽著楊玉奴的胳膊，笑得面容扭曲道："
    },
    {
      "id": "c0290p0027",
      "source": "“走走走，潔身潔身去。”"
    },
    {
      "id": "c0290p0028",
      "source": "楊玉奴一扭搭，委屈道："
    },
    {
      "id": "c0290p0029",
      "source": "“不去，讓太真髒死算了，一千多年不洗澡，一千多年不刷牙，髒死算了，反正太真也是郎君的丫鬟，丟的也不是太真的臉。”"
    },
    {
      "id": "c0290p0030",
      "source": "雲千峰“哼哼”兩聲道："
    },
    {
      "id": "c0290p0031",
      "source": "“不去打死！”"
    },
    {
      "id": "c0290p0032",
      "source": "楊玉奴曲腰行禮，柔聲道："
    },
    {
      "id": "c0290p0033",
      "source": "“太真去就是了，郎君莫嚇唬人，太真膽子小，嚇壞了誰伺候郎君起居？可使不得。”"
    },
    {
      "id": "c0290p0034",
      "source": "這女人對現實的妥協速度，超越光速。"
    },
    {
      "id": "c0290p0035",
      "source": "順風耍脾氣，頂風就轉向，哲學啊！"
    },
    {
      "id": "c0290p0036",
      "source": "就這套太極拳，雲千峰都覺得絲滑，完全無處使力，最後只能順著她走。"
    },
    {
      "id": "c0290p0037",
      "source": "“走走，老爺我帶你去潔身。”"
    },
    {
      "id": "c0290p0038",
      "source": "雲千峰很清楚，楊玉奴對自己說要潔身，那就是怕黑，想叫自己陪著。"
    },
    {
      "id": "c0290p0039",
      "source": "此時主動請纓，卻沒覺得自己被拿捏了，反而有一種對方離不開自己，要依靠自己的滿足感，虛榮心莫名的就被滿足了。"
    },
    {
      "id": "c0290p0040",
      "source": "潤物細無聲，有手段的女人都是這樣讓男人傾家蕩產的。"
    },
    {
      "id": "c0290p0041",
      "source": "楊玉奴在篝火邊上弄了些黑炭，用闊葉包了，又弄了根柔韌的樹枝，用銀牙咬了咬，這便成了牙刷。"
    },
    {
      "id": "c0290p0042",
      "source": "還別說，挺有方法，懂得挺多。"
    },
    {
      "id": "c0290p0043",
      "source": "雲千峰閉目感受一下，沒有被窺伺的感覺，這才領著楊玉奴去溪水源頭的池水邊。"
    },
    {
      "id": "c0290p0044",
      "source": "在雲千峰看來，楊玉奴說出“做牛做馬”那句話時，她所有權就是自己的了，那就不是別人隨便看的，畢竟他不是蘇東坡，也沒有蘇東坡的愛好。"
    },
    {
      "id": "c0290p0045",
      "source": "池水邊的光線分外的好，伸手不見五指。"
    },
    {
      "id": "c0290p0046",
      "source": "挨著邊上洗澡都別想看見。"
    },
    {
      "id": "c0290p0047",
      "source": "楊玉奴在上遊，雲千峰在挨著的下遊，把衣服摸黑用石頭壓在岸邊，就那麽在冰冷的水裡清洗起來。"
    },
    {
      "id": "c0290p0048",
      "source": "每隔一小會，楊玉奴就會問一句："
    },
    {
      "id": "c0290p0049",
      "source": "“郎君在否？”"
    },
    {
      "id": "c0290p0050",
      "source": "“在呢。”"
    },
    {
      "id": "c0290p0051",
      "source": "再隔一會，還問，可見這是多沒有安全感。"
    },
    {
      "id": "c0290p0052",
      "source": "雲千峰後來被問得煩了，就乾脆開始哼小曲，楊玉奴終於不再問了，能聽見。"
    },
    {
      "id": "c0290p0053",
      "source": "雲千峰早早的洗好，穿好皮甲坐在水邊等著，嘴裡還唱著“那一年的雪花飄落梅花開枝頭，那一年的華清池旁留下太多愁.”。"
    },
    {
      "id": "c0290p0054",
      "source": "楊玉奴洗的很仔細，自然也慢，為了乾淨不怕冷。"
    },
    {
      "id": "c0290p0055",
      "source": "“郎君，這是唱我的？”"
    },
    {
      "id": "c0290p0056",
      "source": "“後世唱你的歌多了去了，你洗澡那小破池子都成了旅遊聖地，進去看一眼還得買門票，瑪德！”"
    },
    {
      "id": "c0290p0057",
      "source": "“郎君，能都和太真講講嗎？太真很想知道。”"
    },
    {
      "id": "c0290p0058",
      "source": "“好啊，你啊，老出名了，被稱為華夏五千年裡，最漂亮的四個女人之一”"
    },
    {
      "id": "c0290p0059",
      "source": "“郎君，那這樣一個女人成了你的丫鬟，你可得對她好些。”"
    },
    {
      "id": "c0290p0060",
      "source": "“嗯，那是，盡量不往死打。”"
    },
    {
      "id": "c0290p0061",
      "source": "“.”"
    },
    {
      "id": "c0290p0062",
      "source": "回到篝火旁。"
    },
    {
      "id": "c0290p0063",
      "source": "沐浴後的楊玉奴在微弱的火光下似乎散發著光芒。"
    },
    {
      "id": "c0290p0064",
      "source": "只是簡單的用碳清洗，但近了卻能嗅到淡淡的香，也是神奇。"
    },
    {
      "id": "c0290p0065",
      "source": "疲憊而又吃多了的倆人，就那麽挨著躺在枯草上，露天睡得死沉。"
    },
    {
      "id": "c0290p0066",
      "source": "楊玉奴挨著雲千峰比較近，似乎這樣才能睡踏實，畢竟這裡的一切都讓人不安。"
    },
    {
      "id": "c0290p0067",
      "source": "但又絕對不挨著，保持著一個距離。"
    },
    {
      "id": "c0290p0068",
      "source": "一千多年的折磨，沒讓她學會堅強，隻學會了膽小和恐懼。"
    },
    {
      "id": "c0290p0069",
      "source": "雲千峰感覺到楊玉奴的謹小慎微，心裡暗討："
    },
    {
      "id": "c0290p0070",
      "source": "“知道恐懼的人好啊，知道怕就不會做錯事。不過保持不挨著的距離是什麽意思？看來這女人還是喜歡琴棋書畫的雅人啊！”"
    },
    {
      "id": "c0290p0071",
      "source": "雲千峰翻身，背對著楊玉奴，屁股一拱，故意碰到楊玉奴，後者果然不動聲色的躲了開去，雲千峰嘴角翹了翹，睡沉過去。"
    },
    {
      "id": "c0290p0072",
      "source": "次日天亮。"
    },
    {
      "id": "c0290p0073",
      "source": "雲千峰用兩個小時，使用指揮刀砍樹，搭了一個斜坡避身所，這東西臨時居住，最起碼能遮風擋雨。"
    },
    {
      "id": "c0290p0074",
      "source": "隨後他去那倒霉的野牛群逛了一圈，花費一個多小時時間弄回來一頭公牛。"
    },
    {
      "id": "c0290p0075",
      "source": "午飯前把牛皮剝下，牛角留好，剩下的活都是楊玉奴的。"
    },
    {
      "id": "c0290p0076",
      "source": "一頭牛已經足夠楊玉奴忙活一整天，都未必能弄完。"
    },
    {
      "id": "c0290p0077",
      "source": "所以下午雲千峰便沒了事情做。"
    },
    {
      "id": "c0290p0078",
      "source": "他左思右想，決定出去逛逛。"
    },
    {
      "id": "c0290p0079",
      "source": "“大丫鬟，你在這裡忙著，我出去逛逛，晚些回來，你記得把牛鞭今晚都烤了，那玩意曬幹了不好吃。”"
    },
    {
      "id": "c0290p0080",
      "source": "楊玉奴臉色一下羞紅一片，低頭蚊子聲道："
    },
    {
      "id": "c0290p0081",
      "source": "“嗯”"
    },
    {
      "id": "c0290p0082",
      "source": "嗯完了才想起問："
    },
    {
      "id": "c0290p0083",
      "source": "“郎君去哪？不要走遠，否則太真很怕！”"
    },
    {
      "id": "c0290p0084",
      "source": "雲千峰笑道："
    },
    {
      "id": "c0290p0085",
      "source": "“放心，就這跟前轉轉。”"
    },
    {
      "id": "c0290p0086",
      "source": "說著，順走了楊玉奴原本脖子上那白綾，大踏步的走了出去。"
    },
    {
      "id": "c0290p0087",
      "source": "無邊的苦海之中，一個礁石上，蹲著一個女人，長得還不錯，看著很職業。"
    },
    {
      "id": "c0290p0088",
      "source": "她在陰冷的海風裡瑟瑟發抖，面色慘白的看著茫茫無盡的海水，淚流滿面。"
    },
    {
      "id": "c0290p0089",
      "source": "她很餓，很冷，很怕。"
    },
    {
      "id": "c0290p0090",
      "source": "但是她無處可去，因為礁石的周圍滿是嗜血的鯊魚。"
    },
    {
      "id": "c0290p0091",
      "source": "她只能被困在這裡，在饑餓、寒冷和恐懼裡渡過那漫長的一分一秒。"
    },
    {
      "id": "c0290p0092",
      "source": "就在這時，遠處海面上卻有一個黑色的身影快速移動過來。"
    },
    {
      "id": "c0290p0093",
      "source": "看樣子就好像在衝浪，但是海上明明沒有浪。"
    },
    {
      "id": "c0290p0094",
      "source": "“奇怪，他是怎麽做到速度這麽快？都沒有海浪！”"
    },
    {
      "id": "c0290p0095",
      "source": "“哎喲，想這個幹嘛！”"
    },
    {
      "id": "c0290p0096",
      "source": "這女人急忙站直了，把衣領往開拽了拽，高聲呼喊："
    },
    {
      "id": "c0290p0097",
      "source": "“救命！救命啊！”"
    },
    {
      "id": "c0290p0098",
      "source": "雲千峰正騎著鯊魚快艇亂轉，這遇到一個活的，心知是蚩尤歸位後死的人，否則不能這麽活蹦亂跳。"
    },
    {
      "id": "c0290p0099",
      "source": "當下一撥白綾，迅速的靠了過去。"
    },
    {
      "id": "c0290p0100",
      "source": "那女人忙甩媚眼，酥聲道："
    },
    {
      "id": "c0290p0101",
      "source": "“哥哥救我離開這裡好不好，我會“報答”你的。”"
    },
    {
      "id": "c0290p0102",
      "source": "雲千峰沒回答，而是反問道："
    },
    {
      "id": "c0290p0103",
      "source": "“你有煙嗎？”"
    },
    {
      "id": "c0290p0104",
      "source": "見對方搖頭，雲千峰一撥白綾，頭也不回的去了。"
    },
    {
      "id": "c0290p0105",
      "source": "任憑身後的人怎麽呼喊，他都不搭理。"
    },
    {
      "id": "c0290p0106",
      "source": "既然進了十八層，基本不是好人，該遭的罪，雲千峰可不會幫他們省下，誰讓他們不喊著做牛做馬來著。"
    },
    {
      "id": "c0290p0107",
      "source": "雲千峰繼續閑逛，一個多小時後，才再看到一個有人的礁石。"
    },
    {
      "id": "c0290p0108",
      "source": "更讓他驚訝的是，他一靠近，礁石上的人就喊："
    },
    {
      "id": "c0290p0109",
      "source": "“雲千峰！”"
    },
    {
      "id": "c0290p0110",
      "source": "“嗯？”"
    },
    {
      "id": "c0290p0111",
      "source": "雲千峰一愣，急忙靠停，問道："
    },
    {
      "id": "c0290p0112",
      "source": "“你認識我？”"
    },
    {
      "id": "c0290p0113",
      "source": "那人急忙道："
    },
    {
      "id": "c0290p0114",
      "source": "“快死的時候，有人聯系我，托我死的時候抱著這個打開的背包，直言帶給地獄的朋友，給了我家人不少錢，我自然答應。"
    },
    {
      "id": "c0290p0115",
      "source": "當時我還不信有地獄，如今卻是信了，這包就是給你帶的東西，他們說你拿到了包，就會通知他們，他們就會給我家人另一半酬勞，你可別忘了。”"
    },
    {
      "id": "c0290p0116",
      "source": "雲千峰急忙收過包裹，看到裡面滿是香煙、飲料和酒水。"
    },
    {
      "id": "c0290p0117",
      "source": "一米半的大背包，裝的滿滿登登。"
    },
    {
      "id": "c0290p0118",
      "source": "雲千峰都不用猜，當下就自語笑道："
    },
    {
      "id": "c0290p0119",
      "source": "“羅琳娜啊羅琳娜，你可真是我的知己！”"
    },
    {
      "id": "c0290p0120",
      "source": "說著，背起包，對著那人道："
    },
    {
      "id": "c0290p0121",
      "source": "“放心，會告訴你家人的。”"
    },
    {
      "id": "c0290p0122",
      "source": "順嘴撒謊，從來不臉紅。"
    },
    {
      "id": "c0290p0123",
      "source": "那人見雲千峰這就要走，當下急問："
    },
    {
      "id": "c0290p0124",
      "source": "“在這裡還能再死？”"
    },
    {
      "id": "c0290p0125",
      "source": "他指著鯊魚問的。"
    },
    {
      "id": "c0290p0126",
      "source": "雲千峰很不地道的說："
    },
    {
      "id": "c0290p0127",
      "source": "“那誰知道啊，萬一咬碎了進肚子還不死，更遭罪。”"
    },
    {
      "id": "c0290p0128",
      "source": "說著，一撥白綾，快速離開。"
    },
    {
      "id": "c0290p0129",
      "source": "這一幕，又被閑著的八屠看見。"
    },
    {
      "id": "c0290p0130",
      "source": "“他，他怎麽有心情閑逛的？”"
    },
    {
      "id": "c0290p0131",
      "source": "“他他怎麽會能夠騎鯊魚？”"
    },
    {
      "id": "c0290p0132",
      "source": "“你不是很確定他不會到處走嗎？”"
    },
    {
      "id": "c0290p0133",
      "source": "“我哪知道鯊魚也能騎不是！”"
    },
    {
      "id": "c0290p0134",
      "source": "“那現在怎麽辦？”"
    },
    {
      "id": "c0290p0135",
      "source": "“不能再讓這些人進去，裡面萬一藏了那些不懷好意之人的消息，沒準會出問題。”"
    },
    {
      "id": "c0290p0136",
      "source": "“那咱們就得瀆職，後果很嚴重的。”"
    },
    {
      "id": "c0290p0137",
      "source": "“數量也不是很多，問題不大。”"
    },
    {
      "id": "c0290p0138",
      "source": "正說著，此時值班的那位跑了過來，低聲道："
    },
    {
      "id": "c0290p0139",
      "source": "“不好了，一百零八個死亡意識，記憶裡有給雲千峰帶東西的任務，是不是還放進去？”"
    },
    {
      "id": "c0290p0140",
      "source": "“放不得了，那雲千峰真的到處逛。”"
    },
    {
      "id": "c0290p0141",
      "source": "“沒收東西如何？”"
    },
    {
      "id": "c0290p0142",
      "source": "“沒收東西問題更嚴重，賄與搶，哪個都比換個層數嚴重。”"
    },
    {
      "id": "c0290p0143",
      "source": "“只能放行，否則這麽大的數量，我們若是瀆職，不出多久咱們九個全都得被全知之眼留在地獄裡。”"
    },
    {
      "id": "c0290p0144",
      "source": "“唉只能如此了！”"
    },
    {
      "id": "c0290p0145",
      "source": "“這是誰用的損招啊？很明顯就是奔著坑咱們幾個來的！就希望咱們瀆職，咱們絕不可上當。”"
    },
    {
      "id": "c0290p0146",
      "source": "“他們這是要從根上破壞帝的計劃，讓我們無法控制全知之眼。”"
    },
    {
      "id": "c0290p0147",
      "source": "“叫人去查，阻止他們繼續下去，還有我們也不必太過擔憂，雲千峰也是為人類文明做出犧牲的，暫時過過好日子無何不可，等到我們的死士準備好，結束一切就行了。”"
    },
    {
      "id": "c0290p0148",
      "source": "“言之有理！”"
    },
    {
      "id": "c0290p0149",
      "source": "“.”"
    },
    {
      "id": "c0290p0150",
      "source": "九屠苦惱之時。"
    },
    {
      "id": "c0290p0151",
      "source": "雲千峰正翹著二郎腿，吸著巴西雪茄，看著一邊哭一邊乾活的楊玉奴。"
    },
    {
      "id": "c0290p0152",
      "source": "“郎君就騙人，你說去周圍轉轉，可我後來看那白綾不在，就知道你出海了，妾身怕死了.”"
    },
    {
      "id": "c0290p0153",
      "source": "雲千峰哄她道："
    },
    {
      "id": "c0290p0154",
      "source": "“別哭了，下次肯定不騙你。”"
    },
    {
      "id": "c0290p0155",
      "source": "楊玉奴一撇臉，顯然不信，現在明顯是順風局，得耍脾氣。"
    },
    {
      "id": "c0290p0156",
      "source": "雲千峰一琢磨，決定不哄，換了個方向，怒問道："
    },
    {
      "id": "c0290p0157",
      "source": "“咱倆誰是老爺誰是丫鬟？”"
    },
    {
      "id": "c0290p0158",
      "source": "楊玉奴瞬間轉向，當下急忙擺正態度，低聲道："
    },
    {
      "id": "c0290p0159",
      "source": "“妾身是郎君的大丫鬟。”"
    },
    {
      "id": "c0290p0160",
      "source": "雲千峰思索道："
    },
    {
      "id": "c0290p0161",
      "source": "“你是怎麽稱呼唐明皇的？就用那個稱呼喊我，也得用那個語氣。”"
    },
    {
      "id": "c0290p0162",
      "source": "楊玉奴臉有些燒，猶豫了一會，才柔聲道："
    },
    {
      "id": "c0290p0163",
      "source": "“大家，妾身玉環叩見。”"
    },
    {
      "id": "c0290p0164",
      "source": "雲千峰就覺得全身舒泰，大刺刺坐在破草堆上，一擺手道："
    },
    {
      "id": "c0290p0165",
      "source": "“愛妃平身！”"
    },
    {
      "id": "c0290p0166",
      "source": "這一句，氣的九屠裡面八屠齊聲叱罵。"
    },
    {
      "id": "c0290p0167",
      "source": "“不嫌寒磣！”"
    },
    {
      "id": "c0290p0168",
      "source": "隨後齊齊關閉了監視的光幕，看不下去了。"
    },
    {
      "id": "c0290p0169",
      "source": "他們一關閉光幕，雲千峰嘴角不由得一翹，因為那窺伺的感覺消失了。"
    },
    {
      "id": "c0290p0170",
      "source": "雲千峰就是故意惡心他們的，因為他還有事要做，而且要在不被監視的情況下做。"
    },
    {
      "id": "c0290p0171",
      "source": "就見他快速的折斷一根樹枝，在地上快速的畫出一個圖形，正是這海島的俯瞰圖。"
    },
    {
      "id": "c0290p0172",
      "source": "他用樹枝在這輪廓圖上分出了四個部分，分別寫上辰戌醜未。"
    },
    {
      "id": "c0290p0173",
      "source": "“四庫位置，我今天重新走過，並未見有什麽特別，可見這東XZ得必十分隱秘，大概需要特殊的開關才能尋找，當逃不出衝克制化.”"
    },
    {
      "id": "c0290p0174",
      "source": "想著，他頭也不回，對正努力工作的楊玉奴道："
    },
    {
      "id": "c0290p0175",
      "source": "“大丫鬟，給我去水池裡拿紅色鐵罐來。”"
    },
    {
      "id": "c0290p0176",
      "source": "楊玉奴不知道什麽是可樂，所以說外觀就好。"
    },
    {
      "id": "c0290p0177",
      "source": "楊玉奴用碳和花瓣的混合物洗淨了手上的牛油，拿著可樂遞給雲千峰。"
    },
    {
      "id": "c0290p0178",
      "source": "見雲千峰用力一拽，瓶子就出來一個小口，還冒著白色的冷氣，裡面細微的“嘩嘩”作響，便好奇問道："
    },
    {
      "id": "c0290p0179",
      "source": "“郎君，這是什麽？”"
    },
    {
      "id": "c0290p0180",
      "source": "雲千峰遞給楊玉奴，道："
    },
    {
      "id": "c0290p0181",
      "source": "“嘗嘗。”"
    },
    {
      "id": "c0290p0182",
      "source": "楊玉奴小心的淺嘗一口，頓時眼睛一亮，變成了一大口。"
    },
    {
      "id": "c0290p0183",
      "source": "她愛甜食，天下皆知。"
    },
    {
      "id": "c0290p0184",
      "source": "反正這一刻，楊玉奴不思念荔枝了，愛上了紅罐子。"
    },
    {
      "id": "c0290p0185",
      "source": "雲千峰也不嫌棄，楊玉奴喝過了，他對嘴一樣喝，繼續開始分析："
    },
    {
      "id": "c0290p0186",
      "source": "“既然明面找不到，那麽就是深藏，如果按照衝克之法，四庫藏物，不衝不出，辰戌相衝，醜未相衝，當可將所藏之物顯現。"
    },
    {
      "id": "c0290p0187",
      "source": "可是，辰戌被醜所隔，醜未被戌所隔，彼此無法相交，便無法成衝勢，這可如何是好？難道要用風水局？明日要去重新探查一遍，再做決斷！”"
    },
    {
      "id": "c0290p0188",
      "source": "正想著，旁邊乾活的楊玉奴對他說了句："
    },
    {
      "id": "c0290p0189",
      "source": "“郎君，好累，口渴的很！”"
    },
    {
      "id": "c0290p0190",
      "source": "雲千峰喝了一口可樂，大聲回道："
    },
    {
      "id": "c0290p0191",
      "source": "“旁邊不是有泉水嗎？這也要問！”"
    },
    {
      "id": "c0290p0192",
      "source": "楊玉奴.(⊙﹏⊙)"
    },
    {
      "id": "c0290p0193",
      "source": "感謝雪兒格格、肖娜丶、廟裡供著神、你是聽書客還是故中人、卜歌、帝丶king、尾數39354、尾數25937、尾數32283、莉莉他老公、即刻啟程、好大一個頭、藍橋驛、我想死在可樂瓶裡、藍風の死神、非無用、沒有文化的原始人、戚文、狗三一生之敵、尾數24999、尾數13546、AA冷暖自知AA、尾數21912、尾數00871、可憐兮兮的袁先生、尾數40810、且看風雨122、一念聖墟、老狗薩摩耶、尾數30991、尾數51414、啊！、各有各的獨孤九劍、殘雲道人、遇見不過意外、davpkxxx、尾數22062、武易天下、曾經年少愛追風、尾數41686、3D胸神、書蟲3364、尾數23304、Xenomorph、尾數19972、吉大之南、尾數17573、尾數46317的月票獎勵！！！"
    },
    {
      "id": "c0290p0194",
      "source": "謝謝你們的支持！！！"
    },
    {
      "id": "c0290p0195",
      "source": "又差點超字數，哈哈哈！！！"
    },
    {
      "id": "c0290p0196",
      "source": "祝大家好夢，晚安！！！"
    }
  ],
