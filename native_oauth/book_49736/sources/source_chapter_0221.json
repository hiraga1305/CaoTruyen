{
  "version": "bns-source-v1",
  "book_id": "49736",
  "chapter": 221,
  "title": "221.第221章 墨菲定律",
  "source_ref": "https://czbooks.net/n/s6p7bb/s6pj0fii?chapterNumber=220",
  "segments": [
    {
      "id": "c0221p0001",
      "source": "221.第221章 墨菲定律"
    },
    {
      "id": "c0221p0002",
      "source": "第221章 墨菲定律"
    },
    {
      "id": "c0221p0003",
      "source": "薩弱現在心情很好。"
    },
    {
      "id": "c0221p0004",
      "source": "就好像一隻貓在戲耍老鼠，很愜意。"
    },
    {
      "id": "c0221p0005",
      "source": "任何言語的刺怒都毫無意義，這才是最真實的快樂。"
    },
    {
      "id": "c0221p0006",
      "source": "想著，她挑動手指，棚頂的燈冒著火花砸向了雲千峰。"
    },
    {
      "id": "c0221p0007",
      "source": "雲千峰深呼吸，攢足了一口氣，猛然發力滾開，來到了牆角那柚木木人樁之前。"
    },
    {
      "id": "c0221p0008",
      "source": "隨後，他抱起木人樁，扭腰轉身把砸向自己的東西崩開，然後松手投出，砸向薩弱。"
    },
    {
      "id": "c0221p0009",
      "source": "薩弱淡淡笑著，沒在意，輕輕一撩手。"
    },
    {
      "id": "c0221p0010",
      "source": "然而她大意了，那木人樁竟然沒有被自己的精神力影響，而她失去了完美躲避的機會。"
    },
    {
      "id": "c0221p0011",
      "source": "“咚！”"
    },
    {
      "id": "c0221p0012",
      "source": "薩弱被砸得向後飛去，吃了交手以來的第二次虧。"
    },
    {
      "id": "c0221p0013",
      "source": "雲千峰雙臂的力量可不比她弱。"
    },
    {
      "id": "c0221p0014",
      "source": "薩弱隨意向地面虛擺手掌，似有無形之力卷著她的身體，就那麽直直的飄站起來。"
    },
    {
      "id": "c0221p0015",
      "source": "然而，剛站直就看到了雲千峰的臉幾乎貼著自己。"
    },
    {
      "id": "c0221p0016",
      "source": "她急忙後退，伴隨著“刺啦”一聲響，皮衣直接被雲千峰撕開了兩瓣，映出了大片雪白。"
    },
    {
      "id": "c0221p0017",
      "source": "這還不算完。"
    },
    {
      "id": "c0221p0018",
      "source": "雲千峰一手撕開衣服，另一隻手抓住地上的木人樁同時掄了上來，再次砸中了薩弱。"
    },
    {
      "id": "c0221p0019",
      "source": "這次是腦袋。"
    },
    {
      "id": "c0221p0020",
      "source": "“卡擦！”"
    },
    {
      "id": "c0221p0021",
      "source": "堅硬的柚木木人樁直接砸得碎成幾塊，碎裂的柚木瓣在薩弱臉上留下了幾道傷痕，滲出血來。"
    },
    {
      "id": "c0221p0022",
      "source": "“血木！”"
    },
    {
      "id": "c0221p0023",
      "source": "薩弱驚聲。"
    },
    {
      "id": "c0221p0024",
      "source": "她知道這個貓戲老鼠的遊戲該結束了，否則自己搞不好要翻車。"
    },
    {
      "id": "c0221p0025",
      "source": "當下怒吼一聲，一股巨大的力量在她身上迸發出來，把周圍的一切震得向外散去。"
    },
    {
      "id": "c0221p0026",
      "source": "與此同時，一對黑色如鷹的翅膀在薩弱肋下伸展出來。"
    },
    {
      "id": "c0221p0027",
      "source": "那翅膀把僅剩下一點皮衣也帶了下去。"
    },
    {
      "id": "c0221p0028",
      "source": "“刺啦！”"
    },
    {
      "id": "c0221p0029",
      "source": "褲子又碎了半截，在褲腰處被撕裂的。"
    },
    {
      "id": "c0221p0030",
      "source": "雲千峰是得空就上手，那手勁撕個皮革，和撕紙差不多。"
    },
    {
      "id": "c0221p0031",
      "source": "薩弱一身清涼，黑翅黑發白身，貼在棚頂上，俯瞰著雲千峰，滿目怒意。"
    },
    {
      "id": "c0221p0032",
      "source": "“結束了，回歸我吧！”"
    },
    {
      "id": "c0221p0033",
      "source": "一股旋風包圍了雲千峰，雲千峰再次感受到那熟悉的抽離感。"
    },
    {
      "id": "c0221p0034",
      "source": "然而，薩弱驚訝的是，雲千峰的臉上沒有絲毫的恐懼，反而是笑的得意。"
    },
    {
      "id": "c0221p0035",
      "source": "他咬牙抵抗著薩弱精神力的侵襲，冷笑道："
    },
    {
      "id": "c0221p0036",
      "source": "“是啊，結束了！”"
    },
    {
      "id": "c0221p0037",
      "source": "說著，他看向窗外。"
    },
    {
      "id": "c0221p0038",
      "source": "薩弱下意識的也斜眼看向窗戶。"
    },
    {
      "id": "c0221p0039",
      "source": "窗戶面向東南方向。"
    },
    {
      "id": "c0221p0040",
      "source": "此時此刻，透過窗戶，可以看到遠處天邊露出了一抹淡金色。"
    },
    {
      "id": "c0221p0041",
      "source": "那是太陽即將升起的征兆。"
    },
    {
      "id": "c0221p0042",
      "source": "“怎麽可能！”"
    },
    {
      "id": "c0221p0043",
      "source": "也就在那一瞬間，太陽漏出了一絲金邊，迸射出萬道金光。"
    },
    {
      "id": "c0221p0044",
      "source": "“啊！”"
    },
    {
      "id": "c0221p0045",
      "source": "一抹陽光透過窗戶照射進來，在薩弱後背上留下了道道傷口和冒起的黑煙。"
    },
    {
      "id": "c0221p0046",
      "source": "薩弱慘叫著，放棄了對雲千峰的精神力侵襲，急忙向下俯衝，躲過了陽光的直射。"
    },
    {
      "id": "c0221p0047",
      "source": "但是這還不夠，只是被牆面折射過來的陽光，也讓她無法忍受，皮膚開始泛紅。"
    },
    {
      "id": "c0221p0048",
      "source": "她急忙招手，屋內的雙人床滾翻著飛起來，貼在了窗戶上，把陽光阻擋在窗外。"
    },
    {
      "id": "c0221p0049",
      "source": "薩弱現在悟了。"
    },
    {
      "id": "c0221p0050",
      "source": "人家早就知道自己回來，而且早早的就設計好了陷阱。"
    },
    {
      "id": "c0221p0051",
      "source": "她來到這裡前後也不過半個小時，而且她在這周圍利用那些小金字塔影響了時空，相當於把原本因為地球重力而彎曲的時間線抻直。"
    },
    {
      "id": "c0221p0052",
      "source": "也就是說，這裡的時間流速很快，房間內半個小時時間，外面最多過去一兩分鍾，怎麽可能天就亮了？"
    },
    {
      "id": "c0221p0053",
      "source": "“這個混蛋，他一定是找到了當時蒲卡山布陣的五色金字塔，並且搞清楚了陣法的使用方法，然後逆向圍著房間排列，扭曲室內的時間線，讓這裡的時間流速變得極慢。"
    },
    {
      "id": "c0221p0054",
      "source": "這樣的話，室內半個小時，外面已經是幾個小時過去！"
    },
    {
      "id": "c0221p0055",
      "source": "我用的是簡化的陣法，而他用的是整套的陣法，大陣抵消了小陣的效果。"
    },
    {
      "id": "c0221p0056",
      "source": "難怪他一直破壞我的衣服，他是希望我一下就被陽光燒死，其心歹毒！”"
    },
    {
      "id": "c0221p0057",
      "source": "薩弱猜得沒錯。"
    },
    {
      "id": "c0221p0058",
      "source": "雲千峰手機震動，是羅琳娜發的一張照片。"
    },
    {
      "id": "c0221p0059",
      "source": "照片裡是薩弱在黎府機場走出來的畫面。"
    },
    {
      "id": "c0221p0060",
      "source": "那一刻，雲千峰就知道她來了，於是讓人都散出去，同時讓白狐帶著背包出去，就是為了布陣。"
    },
    {
      "id": "c0221p0061",
      "source": "因為不確定周圍有沒有薩弱這些怪物的奸細，所以雲千峰用了給白狐按摩的借口，可謂小心到極致。"
    },
    {
      "id": "c0221p0062",
      "source": "薩弱此刻懂了，但貌似晚了。"
    },
    {
      "id": "c0221p0063",
      "source": "雲千峰這人屁話多，但絕不是在對戰的時候。"
    },
    {
      "id": "c0221p0064",
      "source": "剛才話多，那是拖延時間，現在嗎！"
    },
    {
      "id": "c0221p0065",
      "source": "他衝上去，二話不說，就是一頓拳頭。"
    },
    {
      "id": "c0221p0066",
      "source": "每一下都是全力以赴，往死裡打。"
    },
    {
      "id": "c0221p0067",
      "source": "現在薩弱的精神力大部分用來堵窗戶，只能靠著強韌的身體與雲千峰搏鬥，而且還不敢移動腳步。"
    },
    {
      "id": "c0221p0068",
      "source": "因為只要稍有閃失，堵著窗戶的大床落下來，她真的一下就能被陽光照死。"
    },
    {
      "id": "c0221p0069",
      "source": "單手難敵雙拳，薩弱隻好用一雙翅膀當盾牌，阻擋著雲千峰那一下下要命的拳頭。"
    },
    {
      "id": "c0221p0070",
      "source": "疼，很疼！"
    },
    {
      "id": "c0221p0071",
      "source": "但薩弱清楚，這樣的攻擊，打一輩子也別想打死她。"
    },
    {
      "id": "c0221p0072",
      "source": "她把自己護在翅膀內，咬牙陰冷道："
    },
    {
      "id": "c0221p0073",
      "source": "“天總會黑下來，而你終將被我殺死！成為我的一部分！”"
    },
    {
      "id": "c0221p0074",
      "source": "雲千峰打了半天沒什麽效果，於是一邊歇氣，一邊笑道："
    },
    {
      "id": "c0221p0075",
      "source": "“天亮了，外面就把大陣撤去了，換句話說，在這間屋子內，估計要保持天亮半個月，也就是說，再不濟我就揍你十四天，然後跑路。”"
    },
    {
      "id": "c0221p0076",
      "source": "薩弱咬牙切齒，道："
    },
    {
      "id": "c0221p0077",
      "source": "“你逃不掉，無論伱去哪裡，我都能感應到你，今日你對我做的一切，未來我會十倍償還，讓你明白褻瀆神的代價！”"
    },
    {
      "id": "c0221p0078",
      "source": "雲千峰冷笑道："
    },
    {
      "id": "c0221p0079",
      "source": "“你要是這麽說的話，那我還不能跑了，得弄死你！”"
    },
    {
      "id": "c0221p0080",
      "source": "說著開始在地上尋找起來。"
    },
    {
      "id": "c0221p0081",
      "source": "薩弱大聲笑道："
    },
    {
      "id": "c0221p0082",
      "source": "“別找了！你剛才發瘋攻擊我的時候，我已經用精神力將血木全都用布卷走，所以你殺不了我，你只能眼睜睜的等著天黑下來，然後等待我要你的命。”"
    },
    {
      "id": "c0221p0083",
      "source": "雲千峰看到了薩弱身後的布包，那裡面就是碎裂的木人樁。"
    },
    {
      "id": "c0221p0084",
      "source": "看著薩弱帶著恨意和得意兩種情緒的目光，雲千峰突然用雙手扒開薩弱的雙翅，照著薩弱的臉“啐”了一口唾沫。"
    },
    {
      "id": "c0221p0085",
      "source": "薩弱沒想到這一招，被雲千峰的唾沫直接命中。"
    },
    {
      "id": "c0221p0086",
      "source": "當下竟然被氣得一下愣住。"
    },
    {
      "id": "c0221p0087",
      "source": "有生以來，第一次被一個人類吐了口水！"
    },
    {
      "id": "c0221p0088",
      "source": "奇恥大辱。"
    },
    {
      "id": "c0221p0089",
      "source": "雲千峰一招得手，急忙彎腰，用手在地上爬，想要繞到薩弱身後，拿到柚木，戳死丫的。"
    },
    {
      "id": "c0221p0090",
      "source": "然而剛爬了兩步，就被一支大翅膀蓋在臉上，緊接著自己的右腿腳踝被攥住，一下被甩了回去。"
    },
    {
      "id": "c0221p0091",
      "source": "在地上打了兩個滾的雲千峰爬起來，衝上去又給了薩弱幾拳，同時琢磨著怎麽再想辦法繞過去。"
    },
    {
      "id": "c0221p0092",
      "source": "幾拳打完，薩弱散開翅膀，笑看著雲千峰，大聲笑道："
    },
    {
      "id": "c0221p0093",
      "source": "“哈哈哈愚蠢的.”"
    },
    {
      "id": "c0221p0094",
      "source": "“啐！”"
    },
    {
      "id": "c0221p0095",
      "source": "“呃！”"
    },
    {
      "id": "c0221p0096",
      "source": "這一口吐得太準，薩弱要瘋了，怒視著雲千峰“啐”。"
    },
    {
      "id": "c0221p0097",
      "source": "雲千峰沒想到神也用這埋汰招，有生以來，第一次被神啐了一口口水，也是沒躲開。"
    },
    {
      "id": "c0221p0098",
      "source": "但雲千峰可不擦，所謂唾面自乾。"
    },
    {
      "id": "c0221p0099",
      "source": "“啐！啐！啐！”"
    },
    {
      "id": "c0221p0100",
      "source": "而是回敬了好幾口，命中面部率達到百分之六十。"
    },
    {
      "id": "c0221p0101",
      "source": "這玩意打也打不死，還不如吐口水更解氣些。"
    },
    {
      "id": "c0221p0102",
      "source": "同時想著："
    },
    {
      "id": "c0221p0103",
      "source": "“這陣法能進不能出，內外時間又不一致，白狐沒辦法知道裡面到底是什麽情況，她需要控制陣法不能進來，這可怎麽辦？"
    },
    {
      "id": "c0221p0104",
      "source": "我出不去，她不進來，就是進來也沒用，不帶著朱砂銀粉，毫無意義，這可如何是好？難道真就這樣硬等著下午白狐撤陣，我和白狐一起跑路，然後繼續等待薩弱的下一次追殺？"
    },
    {
      "id": "c0221p0105",
      "source": "不行，我必須得繞過去，拿到柚木或者撞碎床板，讓薩弱死在這裡！”"
    },
    {
      "id": "c0221p0106",
      "source": "想著，他不顧一切的衝上去。"
    },
    {
      "id": "c0221p0107",
      "source": "這是薩弱最弱勢的時候，雲千峰不能放過這次機會！"
    },
    {
      "id": "c0221p0108",
      "source": "而這一次，他換了打法，使用纏鬥。"
    },
    {
      "id": "c0221p0109",
      "source": "用拳頭貼身靠過去，當薩弱用翅膀阻攔的時候，雲千峰用兩隻手臂撐開她的翅膀，然後用頭裝進薩弱懷裡，這樣她的翅膀便沒了攻擊和保護的效果。"
    },
    {
      "id": "c0221p0110",
      "source": "被雲千峰貼身，薩弱並沒有驚慌，而是扭動著腰肢，用巧勁與雲千峰周旋。"
    },
    {
      "id": "c0221p0111",
      "source": "很快，雲千峰的兩條手臂被薩弱用肋下雙翅的根部卡住，竟然拽不出來。"
    },
    {
      "id": "c0221p0112",
      "source": "四條腿也彼此牽製，大劈跨的姿勢，互相以詭異的角度別在一起，一分一毫也動不得。"
    },
    {
      "id": "c0221p0113",
      "source": "而薩弱還閑著一隻手。"
    },
    {
      "id": "c0221p0114",
      "source": "就見薩弱咬牙切齒，用左拳頭不斷的砸向雲千峰的腦側，震得雲千峰眼前發黑，要不是蚩尤的頭盔，估計一拳就被震脫了大腦。"
    },
    {
      "id": "c0221p0115",
      "source": "被砸了幾下之後，雲千峰一偏頭，用嘴巴咬住了薩弱的手腕，這下薩弱也沒了能用的手。"
    },
    {
      "id": "c0221p0116",
      "source": "但薩弱也真是打得急眼了，竟然把腦袋往前一探，咬住了雲千峰的脖子。"
    },
    {
      "id": "c0221p0117",
      "source": "這下好了，倆人就好像系成了死扣的繩子，誰也無法再攻擊對方，連狠話都說不了，嘴巴都用上了。"
    },
    {
      "id": "c0221p0118",
      "source": "“哼哼”，薩弱陰陰一笑。"
    },
    {
      "id": "c0221p0119",
      "source": "雲千峰讀出那一笑的含義，那就是等著瞧吧，天會黑下來。"
    },
    {
      "id": "c0221p0120",
      "source": "“嘿！”"
    },
    {
      "id": "c0221p0121",
      "source": "雲千峰用力掙扎了幾下，但是倆人現在互相纏著，根本無法動彈分毫，薩弱的力氣也是不弱的。"
    },
    {
      "id": "c0221p0122",
      "source": "雲千峰感受了一下全身，發現還有一個地方能動，那就是腰。"
    },
    {
      "id": "c0221p0123",
      "source": "於是，他用鼻子使勁一吸氣，腰部向後一塌，隨後猛然用鼻子噴氣，腰部斜向上一撞。"
    },
    {
      "id": "c0221p0124",
      "source": "這是太極拳貼身近戰的招式。"
    },
    {
      "id": "c0221p0125",
      "source": "“嗯！”"
    },
    {
      "id": "c0221p0126",
      "source": "薩弱鼻子擠出了一聲詭異婉轉的鼻音，嘴巴陡然一下咬緊，牙齒比之前更加用力。"
    },
    {
      "id": "c0221p0127",
      "source": "雲千峰愣住："
    },
    {
      "id": "c0221p0128",
      "source": "“？？？”"
    },
    {
      "id": "c0221p0129",
      "source": "感謝：你是聽書客還是故中人、喜歡讀書好書難求、尾數19428、尾數16828、Xenomorph、尾數02605、首勝可拿、竹樽的月票獎勵。"
    },
    {
      "id": "c0221p0130",
      "source": "謝謝你們的支持，感激！！！"
    },
    {
      "id": "c0221p0131",
      "source": "祝大家好夢！！！"
    },
    {
      "id": "c0221p0132",
      "source": "晚安！！！"
    }
  ],
