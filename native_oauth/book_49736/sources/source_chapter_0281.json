{
  "version": "bns-source-v1",
  "book_id": "49736",
  "chapter": 281,
  "title": "281.第281章 地藏王",
  "source_ref": "https://czbooks.net/n/s6p7bb/s6ppgb5f?chapterNumber=280",
  "segments": [
    {
      "id": "c0281p0001",
      "source": "281.第281章 地藏王"
    },
    {
      "id": "c0281p0002",
      "source": "第281章 地藏王"
    },
    {
      "id": "c0281p0003",
      "source": "涼風習習，不冷不熱。"
    },
    {
      "id": "c0281p0004",
      "source": "淡霧自腳下緩緩而起，如煙縷縷。"
    },
    {
      "id": "c0281p0005",
      "source": "周圍一片桂樹，花香滿溢。"
    },
    {
      "id": "c0281p0006",
      "source": "遠處薄霧之中，流水潺潺，一座白玉小拱橋橫架其上。"
    },
    {
      "id": "c0281p0007",
      "source": "橋對面是亭台樓閣，眼見似乎皆為玉石，精而雅致。"
    },
    {
      "id": "c0281p0008",
      "source": "這裡，這般情景，雲千峰見過，但卻是在夢中。"
    },
    {
      "id": "c0281p0009",
      "source": "而此刻，他掐了一下大腿，確定自己是醒著的。"
    },
    {
      "id": "c0281p0010",
      "source": "遠處，一個輕盈飄逸的身影正在飛奔而來。"
    },
    {
      "id": "c0281p0011",
      "source": "她赤著腳，著白裙，長發松挽，斜插一根玉簪，面上帶著一個青銅虎面具。"
    },
    {
      "id": "c0281p0012",
      "source": "人未至，柔而淨的聲音先遠遠傳來。"
    },
    {
      "id": "c0281p0013",
      "source": "“良人！”"
    },
    {
      "id": "c0281p0014",
      "source": "倩影在前，雲千峰急忙迎上去。"
    },
    {
      "id": "c0281p0015",
      "source": "倆人雖然只在夢中見過幾次，但不知為何，雲千峰每每想起時光流影之中，等待他來禮成婚禮的那雙眼睛，就會覺得無比的虧欠。"
    },
    {
      "id": "c0281p0016",
      "source": "那是由心而發的，根本不受雲千峰自己的情緒控制。"
    },
    {
      "id": "c0281p0017",
      "source": "再一次，倆人無比的靠近了。"
    },
    {
      "id": "c0281p0018",
      "source": "雲千峰緊緊的盯著姮娥的眼睛，不瞬的看著，直到姮娥撲到了他的懷裡，雲千峰才伸出雙臂，緊緊摟住姮娥的細背，讓她更加的貼緊自己。"
    },
    {
      "id": "c0281p0019",
      "source": "他笑了，由心的笑了。"
    },
    {
      "id": "c0281p0020",
      "source": "“良人，你終於來了。”"
    },
    {
      "id": "c0281p0021",
      "source": "“姮娥，我來了，這裡是我的終點站嗎？”"
    },
    {
      "id": "c0281p0022",
      "source": "姮娥點了點頭，沒有出聲。"
    },
    {
      "id": "c0281p0023",
      "source": "雲千峰繼續柔聲道："
    },
    {
      "id": "c0281p0024",
      "source": "“你也是帝嚳算計的執行者嗎？”"
    },
    {
      "id": "c0281p0025",
      "source": "姮娥再次點了點頭，雖然沒有出聲。"
    },
    {
      "id": "c0281p0026",
      "source": "但卻沒有絲毫隱瞞，雲千峰問什麽，她都不會拒絕回答，而且回答的便是真話。"
    },
    {
      "id": "c0281p0027",
      "source": "“恨我嗎？”"
    },
    {
      "id": "c0281p0028",
      "source": "雲千峰沉默了半晌，然後搖了搖頭，沒有說話。"
    },
    {
      "id": "c0281p0029",
      "source": "“為什麽？”"
    },
    {
      "id": "c0281p0030",
      "source": "雲千峰又是沉默了好一會，才搖頭道："
    },
    {
      "id": "c0281p0031",
      "source": "“不知道，就是不恨。”"
    },
    {
      "id": "c0281p0032",
      "source": "也都是實話。"
    },
    {
      "id": "c0281p0033",
      "source": "雲千峰雙臂又用了一些力，把姮娥更抱緊一些，不知道為何，哪怕就在眼前，就在身邊，還是覺得不夠近。"
    },
    {
      "id": "c0281p0034",
      "source": "是共工的情感嗎？"
    },
    {
      "id": "c0281p0035",
      "source": "姮娥也是這樣，一雙手臂不斷的把自己擠壓向雲千峰。"
    },
    {
      "id": "c0281p0036",
      "source": "“姮娥，接下來我需要做什麽？穿上完整的蚩尤嗎？”"
    },
    {
      "id": "c0281p0037",
      "source": "姮娥點了點頭，柔聲道："
    },
    {
      "id": "c0281p0038",
      "source": "“九屠會告訴你該做什麽，他們就在桂花叢裡看著我們。”"
    },
    {
      "id": "c0281p0039",
      "source": "雲千峰回頭看向桂花林，大聲道："
    },
    {
      "id": "c0281p0040",
      "source": "“喂！你們能不能去遠點？我和我妻子小別再見，你們能不能給點私人空間？”"
    },
    {
      "id": "c0281p0041",
      "source": "這不喊還好，一喊把九個人都喊出來了，距離更近了。"
    },
    {
      "id": "c0281p0042",
      "source": "九屠為首的是個邋遢老道，他冷靜的看著雲千峰，聲音很慈祥，沒有敵意，更沒有殺氣，他道："
    },
    {
      "id": "c0281p0043",
      "source": "“西王母有命，雲千峰一入廣寒宮，我等九人便要寸目不離。”"
    },
    {
      "id": "c0281p0044",
      "source": "雲千峰笑道："
    },
    {
      "id": "c0281p0045",
      "source": "“你們不是只聽帝命嗎？”"
    },
    {
      "id": "c0281p0046",
      "source": "那邋遢老道笑道："
    },
    {
      "id": "c0281p0047",
      "source": "“聽西王母之命，就是帝嚳給的命令。”"
    },
    {
      "id": "c0281p0048",
      "source": "似乎看出雲千峰疑惑什麽，邋遢老道補充道："
    },
    {
      "id": "c0281p0049",
      "source": "“數千年前便口傳的命令。”"
    },
    {
      "id": "c0281p0050",
      "source": "雲千峰撇嘴道："
    },
    {
      "id": "c0281p0051",
      "source": "“口傳的命令可未必準，補天之門熱鬧得很。”"
    },
    {
      "id": "c0281p0052",
      "source": "邋遢老道笑道："
    },
    {
      "id": "c0281p0053",
      "source": "“影響不到九屠，九屠等到今天才入世，便是不沾因果，不沾因果，補天之門對我們也無可奈何，你不就躲了因果嗎？所以帝嚳的命令，保真。”"
    },
    {
      "id": "c0281p0054",
      "source": "雲千峰知道人是攆不走了，於是隻好直奔主題，問道："
    },
    {
      "id": "c0281p0055",
      "source": "“蚩尤完整後，我會如何？”"
    },
    {
      "id": "c0281p0056",
      "source": "邋遢老道道："
    },
    {
      "id": "c0281p0057",
      "source": "“全知之眼入腦，你瞬死。”"
    },
    {
      "id": "c0281p0058",
      "source": "雲千峰冷聲道："
    },
    {
      "id": "c0281p0059",
      "source": "“就這？”"
    },
    {
      "id": "c0281p0060",
      "source": "邋遢老道繼續道："
    },
    {
      "id": "c0281p0061",
      "source": "“此死非死，你的意識和記憶，將在全知之眼入腦一瞬間，進入女閻羅人利用全知之眼打造的空間，繼續存在。”"
    },
    {
      "id": "c0281p0062",
      "source": "雲千峰思索問道："
    },
    {
      "id": "c0281p0063",
      "source": "“以什麽狀態存在？”"
    },
    {
      "id": "c0281p0064",
      "source": "老道笑道："
    },
    {
      "id": "c0281p0065",
      "source": "“若是從感知來說，你會覺得與現在沒有差別，但事實上，你已經是全知之眼內的一組活躍的數據。”"
    },
    {
      "id": "c0281p0066",
      "source": "姮娥接話道："
    },
    {
      "id": "c0281p0067",
      "source": "“良人，你要知道，即便是現在的你，或者說每一個人，本質上都是不同能量波動的組合體，而能量歸根結底也是數據。"
    },
    {
      "id": "c0281p0068",
      "source": "所以在全知之眼的儲存空間內，數據要活躍也需要能量，人的數據在其中受到其它數據的外力干擾”"
    },
    {
      "id": "c0281p0069",
      "source": "姮娥語速雖然很快，但是邋遢老道還是很快的打斷了她的話，笑道："
    },
    {
      "id": "c0281p0070",
      "source": "“我們會告訴雲千峰一切的，等他進入全知之眼之後。”"
    },
    {
      "id": "c0281p0071",
      "source": "姮娥微微點頭，果然不再出聲。"
    },
    {
      "id": "c0281p0072",
      "source": "雲千峰則在心裡琢磨姮娥的那句話。"
    },
    {
      "id": "c0281p0073",
      "source": "姮娥看似不經意的一段話，說的應該是很重要的東西，否則老道不會打斷。"
    },
    {
      "id": "c0281p0074",
      "source": "雲千峰笑道："
    },
    {
      "id": "c0281p0075",
      "source": "“那你告訴我，如果我這組數據，在全知之眼內受到其它數據的干擾會如何？”"
    },
    {
      "id": "c0281p0076",
      "source": "老道笑道："
    },
    {
      "id": "c0281p0077",
      "source": "“不會如何，全知之眼內，永生不死。”"
    },
    {
      "id": "c0281p0078",
      "source": "“謊言！”"
    },
    {
      "id": "c0281p0079",
      "source": "雲千峰第一時間判定，老道說的是謊話，但是他沒出口反駁。"
    },
    {
      "id": "c0281p0080",
      "source": "而是在心裡確定了一件事："
    },
    {
      "id": "c0281p0081",
      "source": "“全知之眼內，也能被殺死。”"
    },
    {
      "id": "c0281p0082",
      "source": "不過雲千峰面色不變，點了點頭，表示自己知道了，然後道："
    },
    {
      "id": "c0281p0083",
      "source": "“幾千上萬年了，我和姮娥還沒洞房呢，你看她面具都不能摘，你說這事怎麽辦吧？”"
    },
    {
      "id": "c0281p0084",
      "source": "老道一攤手，表示他也沒辦法。"
    },
    {
      "id": "c0281p0085",
      "source": "雲千峰顰眉看著遠處，問道："
    },
    {
      "id": "c0281p0086",
      "source": "“姮娥，河水是溫泉嗎？”"
    },
    {
      "id": "c0281p0087",
      "source": "姮娥柔聲道："
    },
    {
      "id": "c0281p0088",
      "source": "“可以是溫泉，這裡是月球之內，你該知道這裡是什麽。”"
    },
    {
      "id": "c0281p0089",
      "source": "雲千峰點頭道："
    },
    {
      "id": "c0281p0090",
      "source": "“機器。”"
    },
    {
      "id": "c0281p0091",
      "source": "姮娥轉頭對九屠道："
    },
    {
      "id": "c0281p0092",
      "source": "“我侍奉良人洗浴，不會離開你們的視線，這裡一切言語你們也聽得到，就不需要擔心什麽了。"
    },
    {
      "id": "c0281p0093",
      "source": "我是帝女，雖然外嫁，但依舊是帝女，我分得清輕重。"
    },
    {
      "id": "c0281p0094",
      "source": "但你們也要理解我與良人的萬年之苦，我心疼他。”"
    },
    {
      "id": "c0281p0095",
      "source": "九屠對姮娥說話可不敢笑嘻嘻，幾個人急忙行禮，表示不敢不從。"
    },
    {
      "id": "c0281p0096",
      "source": "姮娥牽著雲千峰的手來到那河邊，此處距離九屠在幾十米外。"
    },
    {
      "id": "c0281p0097",
      "source": "姮娥動手卸掉雲千峰身上的皮甲，引著他來到已經變得溫暖的河流之中。"
    },
    {
      "id": "c0281p0098",
      "source": "她自己也穿著長裙跟著走入水中。"
    },
    {
      "id": "c0281p0099",
      "source": "河流不寬，只有幾米，但卻不淺，站在其中，恰好只有脖子以外在水面上。"
    },
    {
      "id": "c0281p0100",
      "source": "姮娥輕輕的擦拭雲千峰身上的風塵，身體圍著雲千峰緩緩移動，當她的後背方向對著九屠時，姮娥回手，撩動了一下頭髮，但手指卻在撩動頭髮的路程裡，把衣襟牽開了一塊。"
    },
    {
      "id": "c0281p0101",
      "source": "雲千峰立馬看到那雪白的脖頸上，一個掛墜吊在那裡。"
    },
    {
      "id": "c0281p0102",
      "source": "那是一尊佛像。"
    },
    {
      "id": "c0281p0103",
      "source": "這小小的佛像雕工極為精致，其頭戴寶冠、身披天衣、瓔珞裝飾的天人相，一手持錫杖、一手持蓮花，正是地藏王象。"
    },
    {
      "id": "c0281p0104",
      "source": "“奇怪，姮娥怎麽會帶佛像？她的古老遠遠超過這些，怎麽會突然戴著這個？”"
    },
    {
      "id": "c0281p0105",
      "source": "“是了，她是故意給我看這金吊墜，她不能說話，不能有讓人懷疑的動作，只能用意想不到的方式向我傳達信息，這地藏王金吊墜，就是她要給我的信息，可這是什麽意思呢？”"
    },
    {
      "id": "c0281p0106",
      "source": "感謝龍青蓮、書友尾數17573、書友尾數55783、苒喲、書友尾數51414、書友尾數59686、Xenomorph的月票獎勵，謝謝你們的支持！！！"
    },
    {
      "id": "c0281p0107",
      "source": "今天睡飽了，晚上碼字，開工！！！"
    },
    {
      "id": "c0281p0108",
      "source": "祝大家好夢，晚安！！！"
    }
  ],
